# ── 换行符统一 ──────────────────────────────────────────
# 入库统一为 LF；检出时按平台自动转换（消除 LF→CRLF 告警）
* text=auto

# ── 按文件类型指定换行 ──────────────────────────────────
# Windows 批处理脚本必须使用 CRLF，否则可能无法执行
*.bat text eol=crlf

# Shell 脚本使用 LF
*.sh  text eol=lf

# ── 二进制文件（禁止换行转换）──────────────────────────
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.exe  binary
