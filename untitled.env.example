# ═══════════════════════════════════════════════════════════
# EGO Agent 环境变量配置模板（示例文件，与 config.py 逐项对应，共 115 项）
# 使用方法：复制本文件为 untitled.env 后按需修改
#   Windows：     copy untitled.env.example untitled.env
#   Linux/macOS：  cp   untitled.env.example untitled.env
# 说明：untitled.env 中的值会覆盖 config.py 内置默认值；
#       未列出的变量将使用 config.py 中的默认值。
#       含个人配置的 untitled.env 已被 .gitignore 忽略，请勿提交。
# ═══════════════════════════════════════════════════════════

# ── 日志配置 ──────────────────────────────
EGO_LOG_LEVEL=INFO
EGO_LOG_TO_CONSOLE=false

# ── LMStudio 对话模型配置 ──────────────────────────────
EGO_LM_API_BASE=http://localhost:1234/v1
EGO_LM_MODEL=default-model

# ── FLM 摘要模型配置 ──────────────────────────────
EGO_FLM_API_BASE=http://localhost:52625/v1
EGO_FLM_MODEL=gemma4-it:e4b
EGO_FLM_SUMMARY_TEMPERATURE=0.5
EGO_FLM_SUMMARY_MAX_TOKENS=1024
EGO_FLM_SUMMARY_TIMEOUT=120                    # 秒
# 会话记录超过该字符数时先用 FLM 摘要再入库
EGO_FLM_SUMMARY_TRIGGER_LENGTH=1200
# FLM 摘要目标字符数
EGO_FLM_SUMMARY_TARGET_LENGTH=800

# ── 指令归一化层配置（FLM e4b 转译自然语言 payload → 标准协议，失败透传）────────
# 未启用/服务不可达/字段校验失败 → 透传原 payload，不影响指令执行
EGO_NORM_ENABLED=true
EGO_NORM_API_BASE=http://localhost:52625/v1
EGO_NORM_MODEL=gemma4-it:e4b
EGO_NORM_TEMPERATURE=0.0
EGO_NORM_MAX_TOKENS=1024
EGO_NORM_TIMEOUT=60                         # 秒
# 幂等判定：短于该长度的 MEMO_RD payload 视为已归一化关键词，直接透传
EGO_NORM_MIN_LENGTH=6
# 连续失败熔断：超过该次数则冷却 NORM_CIRCUIT_COOLDOWN 秒跳过转译（字段校验失败不计熔断）
EGO_NORM_CIRCUIT_BREAK=3
EGO_NORM_CIRCUIT_COOLDOWN=300

# ── Ollama Embedding 配置 ──────────────────────────────
EGO_OLLAMA_BASE_URL=http://localhost:11434
EGO_OLLAMA_EMBED_MODEL=bge-m3
# Ollama 模型检测 / 嵌入生成 HTTP 超时（秒）
EGO_OLLAMA_DETECT_TIMEOUT=10
EGO_OLLAMA_EMBED_TIMEOUT=60

# ── 联网检索配置（WEB_SRCH 指令，Tavily REST 直连）────────
# 未启用 / 未配 Key / 服务不可达 → 指令返回失败消息并回注 LLM，不影响主流程
EGO_WEB_SRCH_ENABLED=true
# Tavily API Key（必填，控制台可免费申请：https://app.tavily.com）
EGO_TAVILY_API_KEY=
EGO_WEB_SRCH_API_BASE=https://api.tavily.com/search
# 单次返回条数上限（越大注入 token 越多，建议 3~5）
EGO_WEB_SRCH_MAX_RESULTS=5
# 检索深度：basic | advanced（advanced 更准但更慢/更耗配额）
EGO_WEB_SRCH_SEARCH_DEPTH=basic
# 是否请求 Tavily 综述：false（默认，省 token 与延迟）| basic（短综述）| advanced（详细综述）
EGO_WEB_SRCH_INCLUDE_ANSWER=false
EGO_WEB_SRCH_TIMEOUT=30                        # 秒
# 单条摘要截断长度（控制注入上下文 token 量）
EGO_WEB_SRCH_SNIPPET_MAX_LENGTH=500

# ── API 超时配置（统一管理）──────────────────────────────
EGO_MODEL_DETECT_TIMEOUT=60                   # 模型检测超时（秒），config 默认 30
EGO_LLM_API_TIMEOUT=900                       # LLM API 超时（秒），config 默认 600
EGO_STREAM_NO_TOKEN_TIMEOUT=700               # 流式输出无 Token 超时（秒）
EGO_SESSION_REBUILD_POST_DELAY=60            # Session 重建完成后等待间隔（秒），给 LMStudio 时间整理 KV cache

# ── Reasoning/Think 模式配置 ──────────────────────────────
# 可选值：none/low/medium/high，留空则不发送该参数
EGO_REASONING_EFFORT=none                     # 建议保持 none

# ── Responses API 优化配置 ──────────────────────────────
EGO_RESPONSES_WARMUP=false
EGO_MAX_INITIAL_ROUNDS=5
# 系统初始化温度（Session 建立时使用，较低以保证稳定性）
EGO_TEMPERATURE_INIT=0.3

# ── 冷启动/预热配置 ──────────────────────────────
EGO_TEMPERATURE_COLDSTART=0.7
EGO_TEMPERATURE_PREHEAT=0.7

# ── 与用户对话配置 ──────────────────────────────
EGO_MAX_ROUNDS=3                              # 思考深度（即轮次）
EGO_TEMPERATURE=0.8                           # 与用户对话温度
EGO_MAX_TOKENS=2048

# ── 定时自对话( THINK )配置 ──────────────────────────────
EGO_AUTO_THINK_ENABLED=true
EGO_TEMPERATURE_THINK=0.9                     # 自对话温度
EGO_THINK_INTERVAL=50                         # 轮次间隔（冷启动和预热不计入）
EGO_AUTO_THINK_INTERVAL_MINUTES=180           # 定时间隔（分钟）

# ── 定时自省( REFLECTION )配置 ──────────────────────────────
EGO_AUTO_REFLECTION_ENABLED=true
EGO_TEMPERATURE_REFLECTION=0.7                # 自省温度
EGO_REFLECTION_INTERVAL=99                    # 轮次间隔
EGO_AUTO_REFLECTION_TIME="23:00"              # 定点时间（HH:MM）
EGO_REFLECTION_L2_THRESHOLD=300               # L2 条目数阈值，超过自动触发自省
EGO_REFLECTION_API_TIMEOUT=3600               # 自省超时（秒）
# 阈值触发反思的丢失补偿：后台反思等锁超时被跳过时，延迟该秒数重排一次性重试（默认 30 分钟）
EGO_REFLECTION_THRESHOLD_RETRY_DELAY=1800     # 延迟重试秒数
# 阈值触发反思的最大连续重试次数（超过后放弃重试链，阈值标志已复位，下次对话仍会重新触发）
EGO_REFLECTION_THRESHOLD_MAX_RETRIES=8

# ── 定点审查备忘录（NOTE_REVIEW）配置 ──────────────────────────────
EGO_AUTO_NOTE_REVIEW_ENABLED=true
EGO_AUTO_NOTE_REVIEW_TIME="00:43"              # 建议与自省/自我定义错开，避免锁竞争
EGO_TEMPERATURE_NOTE_REVIEW=0.7                # 审查温度
EGO_NOTE_REVIEW_API_TIMEOUT=3600               # 审查超时（秒）

# ── 每日自我定义（SELF_DEFINITION）配置 ──────────────────────────────
EGO_SELF_DEFINITION_ENABLED=true
EGO_SELF_DEFINITION_TIME="03:00"              # 建议与 EGO_AUTO_REFLECTION_TIME 错开，避免锁竞争
EGO_SELF_DEFINITION_MAX_LENGTH=1200           # 自我定义最大字数
EGO_TEMPERATURE_SELF_DEFINITION=0.7
EGO_SELF_DEFINITION_API_TIMEOUT=1800          # 秒
# 字数弹性容忍系数（接受 MAX_LENGTH × 系数以内，避免轻微波动浪费调用）
EGO_SELF_DEFINITION_LENGTH_TOLERANCE=1.2

# 记忆引用权重周期震荡参数
EGO_MEMORY_CITATION_CYCLE_LENGTH=30           # 周期长度（引用次数）
EGO_MEMORY_CITATION_AMPLITUDE=0.8             # 振幅（最终倍数经边界限制后为 0.6~2.0）
EGO_MEMORY_CITATION_DECAY_RATE=50             # 衰减速率（数值越大衰减越慢）
EGO_MEMORY_CITATION_MIN_BOOST=0.6             # 最小增益倍数
EGO_MEMORY_CITATION_MAX_BOOST=2.0             # 最大增益倍数

# ── ChromaDB 记忆配置 ──────────────────────────────
EGO_CHROMA_PERSIST_DIR=data/chroma_db
EGO_CHROMA_OBJECTIVE_COLLECTION=objective_memory
EGO_CHROMA_RECALL_TOP_K=5
# 后台会话入库待执行任务上限：单 worker 队列在服务变慢时若无限积压会占内存，
# 超出后丢弃最新任务并用日志警告（记忆为辅助功能，失败不影响主流程）
EGO_MEMORY_MAX_PENDING_STORES=50

# ── 运行参数与输出清洗 ──────────────────────────────
# 后台定时任务（反思/自我定义）等待 _agent_lock 的最大秒数，超时则跳过本次任务
EGO_BACKGROUND_TASK_LOCK_WAIT=900
# 后台定时任务（反思/自我定义）等待 _agent_lock 的轮询周期（秒）
EGO_BACKGROUND_TASK_POLL_INTERVAL=15
# 用户命令（/clear /think /reflect）一次性等锁的最大秒数，超时优雅降级提示
EGO_LOCK_ACQUIRE_TIMEOUT=60
# 执行类备忘录到期检查轮询间隔（秒）：调度取 min(最近到期条目, now+该间隔)，到期更近则提前精确触发
EGO_NOTE_CHECK_INTERVAL=60
# 对话历史最大保留条数，超出后只保留最近 N 条
EGO_HISTORY_MAX_ENTRIES=10000
# 输出清洗：仅对超过该长度的文本做英文比例检测
EGO_LONG_TEXT_MIN_LENGTH=100
# 输出清洗：ASCII 字符占比超过该阈值视为英文内容（内部思考泄漏）
EGO_ENGLISH_RATIO_THRESHOLD=0.6
# 输出清洗：移除占位符模式后剩余内容低于原文该比例则判为占位符输出
EGO_OUTPUT_CLEAN_RATIO_THRESHOLD=0.3
# SAY 指令拼接输出的最大总长度（超过则截断后续 SAY，避免无限累积）
EGO_SAY_MAX_OUTPUT_LENGTH=10000

# ── 轮次温度策略曲线（_compute_round_temperature）──────────────────────────────
# 第 1/2/3 次 CONTINUE 的基础温度倍率
EGO_TEMP_ROUND_FACTOR_R1=1.2
EGO_TEMP_ROUND_FACTOR_R2=1.0
EGO_TEMP_ROUND_FACTOR_R3=0.8
# 第 4 次起衰减：factor = max(floor, base - (n-4) * step)
EGO_TEMP_ROUND_DECAY_BASE=0.9
EGO_TEMP_ROUND_DECAY_STEP=0.15
EGO_TEMP_ROUND_DECAY_FLOOR=0.3
# 最终钳制范围
EGO_TEMP_ROUND_MIN=0.1
EGO_TEMP_ROUND_MAX=2.0

# ── Session 恢复配置（初始化/重建/持久化）──────────────────────────────
# Session 初始化时注入的历史对话数量（默认 20 条）
# 用于在无有效缓存时恢复上下文，避免 token 过多
# 建议范围：10-100，根据模型上下文窗口大小调整
EGO_SESSION_INIT_HISTORY_COUNT=20
# Session ID 定期保存间隔（对话轮次），默认每 1 轮对话保存一次
# 用于确保意外退出后能恢复到最近的 Session 状态
# 建议范围：1-10，数值越小实时性越好，但 I/O 频率越高
EGO_SESSION_ID_SAVE_INTERVAL=1
# Session 重建每批消息数
EGO_SESSION_REBUILD_BATCH_SIZE=4
# previous_response_id 探测最大重试次数
EGO_SESSION_ID_PROBE_MAX_RETRIES=2
# previous_response_id 探测请求超时（秒），LMStudio 繁忙时可适当调大
EGO_SESSION_ID_PROBE_TIMEOUT=180

# ── 空闲唤服探测配置 ──────────────────────────────
# 长时间空闲后首个正式请求前，先发一次轻量（max_tokens=1）探测唤醒 LM Studio，
# 避免冷启动首个请求卡死（服务端生成 0 token / no_token 超时）。失败静默降级。
EGO_SERVER_IDLE_WARMUP_THRESHOLD=1200         # 距上次 LLM 活动超过该秒数视为空闲，config 默认 900
EGO_SERVER_WARMUP_TIMEOUT=90                 # 唤醒探测请求超时（秒）

# ── 循环兜底参数 ──────────────────────────────
# 单轮/全程检索次数上限（MEMO_RD / NOTE_RD / WEB_SRCH 共用同一预算，超过则停止检索）
EGO_MEMO_RD_ROUND_LIMIT=3
EGO_MEMO_RD_TOTAL_LIMIT=6
# 连续相似响应达到该次数视为重复循环，强制停止
EGO_MAX_CONSECUTIVE_SIMILAR=2
# debug 日志最多保留文件数（超出删除最旧）
EGO_DEBUG_LOG_MAX_FILES=100
# 冷启动缓存超过该天数时输出刷新建议警告
EGO_CACHE_STALE_WARNING_DAYS=15
# 连续相似/占位符检测所需的最小历史条数（= 轮数 × 2，每轮 2 条消息）
EGO_CONSECUTIVE_SIMILAR_MIN_HISTORY=6
# 连续相似检测辅助条件：单条消息长度不超过该阈值才视为"短重复"
EGO_CONSECUTIVE_SIMILAR_SHORT_LENGTH=20

# ── 记忆检索评分参数（ChromaDB）──────────────────────────────
# MEMO_RD 结果相似度过滤阈值（低于该值丢弃）
EGO_MEMORY_SIMILARITY_THRESHOLD=0.45
# 时间衰减半衰期（天）：weight = 1/(1 + days/N)，越大衰减越慢
EGO_MEMORY_TIME_DECAY_SCALE_DAYS=7.0
# 时间衰减权重下限
EGO_MEMORY_TIME_DECAY_FLOOR=0.3

# ── LLM 客户端参数 ──────────────────────────────
# requests 连接池参数（Session 初始化与重建两处共用）
EGO_HTTP_POOL_CONNECTIONS=10
EGO_HTTP_POOL_MAXSIZE=20
# 系统侧低温度调用（Session 预热/重建）：低温快速、稳定
EGO_TEMPERATURE_WARMUP=0.1

# ── GUI 窗口配置 ──────────────────────────────
# 窗口最小尺寸（像素），防止用户缩得过小导致界面崩坏
EGO_GUI_MIN_WIDTH=720
EGO_GUI_MIN_HEIGHT=520
